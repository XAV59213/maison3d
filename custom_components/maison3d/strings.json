{
  "title": "Maison 3D",
  "config": {
    "step": {
      "user": {
        "title": "Maison 3D",
        "description": "Add the Maison 3D interactive panel to the Home Assistant sidebar."
      }
    },
    "abort": {
      "already_configured": "Maison 3D is already configured.",
      "single_instance_allowed": "[%key:common::config_flow::abort::single_instance_allowed%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Configure Maison 3D sensors and main image",
        "description": "Select sensors and optionally set your own main photo. Leave the URL empty to use the bundled official photo.\n\n{overrides}",
        "data": {
          "project_name": "Project name (shown in the panel, default « Maison 3D »)",
          "weather_entity": "Weather entity",
          "sun_entity": "Sun entity",
          "moon_entity": "Moon phase entity",
          "temperature_entity": "Outdoor temperature sensor",
          "wind_entity": "Wind sensor",
          "rain_entity": "Rain sensor",
          "snow_entity": "Snow sensor",
          "cloud_entity": "Cloud cover sensor",
          "base_image_url": "Main photo (/local/…, /maison3d-media/…, HTTPS or media-source://…)",
          "effects_enabled": "Enable weather, lighting and seasonal effects",
          "frost_enabled": "Enable the frost effect when the temperature is at or below 0 °C",
          "weather_photos_enabled": "Use the bundled/custom day and night weather photos",
          "startup_grace_minutes": "Startup grace after Home Assistant start (0–60 min, default 15). During this time a late source (not found or unavailable, e.g. Netatmo) does not degrade the sensors status."
        }
      }
    },
    "error": {
      "invalid_image_url": "Invalid image URL: use /local/, /maison3d-media/, /maison3d-assets/, /api/, HTTPS or media-source://."
    }
  },
  "entity": {
    "sensor": {
      "sensors_status": {
        "name": "Sensors status",
        "state": {
          "ok": "OK",
          "not_configured": "Not configured",
          "degraded": "Degraded"
        },
        "state_attributes": {
          "sensor_statuses": {
            "name": "Source statuses"
          },
          "configured_count": {
            "name": "Configured sources"
          },
          "available_count": {
            "name": "Available sources"
          },
          "project_name": {
            "name": "Project name"
          },
          "startup_grace": {
            "name": "Startup grace"
          },
          "startup_grace_minutes": {
            "name": "Startup grace (minutes)"
          }
        }
      },
      "season_mode": {
        "name": "Season mode",
        "state": {
          "auto": "Automatic seasons",
          "fixed": "Fixed season"
        },
        "state_attributes": {
          "fixed_season": {
            "name": "Fixed season",
            "state": {
              "spring": "Spring",
              "summer": "Summer",
              "autumn": "Autumn",
              "winter": "Winter"
            }
          }
        }
      },
      "season": {
        "name": "Active season",
        "state": {
          "spring": "Spring",
          "summer": "Summer",
          "autumn": "Autumn",
          "winter": "Winter"
        }
      },
      "photo": {
        "name": "Photo shown",
        "state_attributes": {
          "url": {
            "name": "Photo URL"
          },
          "source": {
            "name": "Photo source"
          },
          "weather_photos": {
            "name": "Weather photos"
          }
        }
      },
      "ambience": {
        "name": "Weather ambience",
        "state": {
          "day": "Day",
          "night": "Night",
          "cloudy": "Cloudy",
          "rain": "Rain",
          "snow": "Snow",
          "wind": "Wind",
          "storm": "Storm",
          "fog": "Fog",
          "spring": "Spring",
          "summer": "Summer",
          "autumn": "Autumn",
          "winter": "Winter"
        },
        "state_attributes": {
          "ambience_mode": {
            "name": "Ambience mode",
            "state": {
              "auto": "Automatic",
              "fixed": "Fixed in the settings"
            }
          },
          "weather_kind": {
            "name": "Live weather"
          },
          "frost": {
            "name": "Frost"
          },
          "effects": {
            "name": "Effects"
          },
          "entities": {
            "name": "Entities used"
          }
        }
      },
      "day_night": {
        "name": "Day or night",
        "state": {
          "day": "Day",
          "night": "Night"
        },
        "state_attributes": {
          "source": {
            "name": "Source",
            "state": {
              "sun": "Sun entity",
              "clock": "Home Assistant clock",
              "fixed_ambience": "Fixed ambience"
            }
          }
        }
      }
    }
  }
}
